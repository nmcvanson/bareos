"""Command-line wrapper of bareos_openstack.tool."""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
# set by configure_file at build time; stays unexpanded in a source tree
PLUGIN_DIR = "@plugindir@"
CANDIDATES = (PLUGIN_DIR, "/usr/lib/bareos/plugins", "/usr/lib64/bareos/plugins", HERE)
for path in reversed(CANDIDATES):
    if not path.startswith("@") and os.path.isdir(path) and path not in sys.path:
        sys.path.insert(0, path)

from bareos_openstack import tool  # noqa: E402  pylint: disable=wrong-import-position

if __name__ == "__main__":
    sys.exit(tool.main())
