# The native S3 transport against the stub responder s3-stub.py (a test
# double that keeps the objects as files and checks every request's AWS
# signature): backup and restore, reading and appending across both
# transports, retries after a server error and after a damaged upload.

set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

JobName=backup-bareos-fd

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

control_dir="${tmp}/s3stub"
requests_log="${control_dir}/requests.log"
access_key="AKIATESTSTUBKEY0001"
secret_key="stubsecret0123456789abcdefghijklmnopqrst"
stub_pid=""

stop_stub()
{
  if [ -n "${stub_pid}" ]; then
    kill "${stub_pid}" 2>/dev/null || :
    stub_pid=""
  fi
}

# Starts the stub on a free port and writes the s3cmd configuration the
# device reads.
start_stub()
{
  mkdir -p "${control_dir}" "${archivedir}"
  rm -f "${control_dir}/port" "${requests_log}"
  python3 ./s3-stub.py "${archivedir}" "${control_dir}" testbucket \
    "${access_key}" "${secret_key}" us-east-1 >"${control_dir}/stub.out" 2>&1 &
  stub_pid=$!
  local waited=0
  while [ ! -f "${control_dir}/port" ]; do
    sleep 0.2
    waited=$((waited + 1))
    if ((waited > 50)); then
      echo "the stub responder did not start" >&2
      cat "${control_dir}/stub.out" >&2 || :
      exit 1
    fi
  done
  local port
  port=$(cat "${control_dir}/port")
  umask 077
  cat >"${tmp}/s3cfg" <<END_OF_DATA
[default]
access_key = ${access_key}
secret_key = ${secret_key}
host_base = 127.0.0.1:${port}
host_bucket = 127.0.0.1:${port}
use_https = False
bucket_location = us-east-1
END_OF_DATA
  umask 022
}

queued_jobid()
{
  grep 'Job queued. JobId=' "$1" | tail -n 1 | sed -n -e 's/^.*JobId=//p'
}

console_output()
{
  "${BAREOS_BCONSOLE_BINARY}" -c "${BAREOS_CONFIG_DIR}" <<<"$1"
}

expect_termination()
{
  local jobid="$1" expected="$2" joblog
  joblog=$(console_output "list joblog jobid=${jobid}")
  if ! grep -q "Termination:.*${expected}" <<<"${joblog}"; then
    set_error "job ${jobid} did not end with \"${expected}\""
  fi
}

# Runs a full backup of the SelfTest fileset to a storage; sets backup_jobid.
backup_to()
{
  local storage="$1"
  cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $tmp/backup-${storage}.log
run job=$JobName level=Full storage=${storage} yes
wait
messages
quit
END_OF_DATA
  run_bconsole
  backup_jobid=$(queued_jobid "$tmp/backup-${storage}.log")
  expect_termination "${backup_jobid}" "Backup OK"
}

# Restores a job from a storage and compares the result with the source.
restore_from()
{
  local jobid="$1" storage="$2" target
  target="$RestoreDirectory/${jobid}-${storage}"
  rm -rf "${target}"
  cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $tmp/restore-${jobid}-${storage}.log
restore jobid=${jobid} client=bareos-fd storage=${storage} where=${target} all done yes
wait
messages
quit
END_OF_DATA
  run_bconsole
  check_log "$tmp/restore-${jobid}-${storage}.log"
  check_restore_diff "${BackupDirectory}" "${target}"
}

# Number of logged requests that match an extended regular expression.
count_requests()
{
  grep -cE "$1" "${requests_log}" || :
}

setup_data
# More than two chunks of incompressible data, so that a listing needs pages.
dd if=/dev/urandom of="${BackupDirectory}/random.bin" bs=1M count=25 2>/dev/null

start_stub
start_test
# Also stops the stub when the test ends early.
trap '
       EXITCODE=$?;
       stop_stub;
       echo "exit($EXITCODE) is called. Set test to failure and end test.";
       estat=998;
       end_test;
    ' EXIT

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out /dev/null
messages
@$out $tmp/label.log
label volume=TestVolume001 storage=dplcompat pool=Full
quit
END_OF_DATA
run_bconsole

# The SD traces every request at this level; step 8 looks for the keys in it.
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $tmp/setdebug.log
setdebug level=200 trace=1 storage=dplcompat
quit
END_OF_DATA
run_bconsole

# 1. Backup and restore through the native transport.
backup_to dplcompat
first_jobid=${backup_jobid}
restore_from "${first_jobid}" dplcompat
if (($(count_requests '^PUT ') < 3)); then
  set_error "the native transport sent fewer than 3 PUT requests"
fi
if (($(count_requests 'sig=(bad|none)') != 0)); then
  set_error "the stub saw a request without a valid signature"
  grep -E 'sig=(bad|none)' "${requests_log}" | head -n 5 >&2 || :
fi
if (($(count_requests '^GET .* 206 ') < 1)) \
  && (($(count_requests '^GET /testbucket/') < 1)); then
  set_error "the restore did not download any chunk"
fi

# 2. The program transport reads what the native transport wrote.
restore_from "${first_jobid}" dplcompat-program

# 3. The program transport appends to the volume, the native transport reads it.
backup_to dplcompat-program
second_jobid=${backup_jobid}
restore_from "${second_jobid}" dplcompat
restore_from "${first_jobid}" dplcompat

# 4. A server error on two uploads is retried inside the transport.
echo 2 >"${control_dir}/put500"
backup_to dplcompat
third_jobid=${backup_jobid}
if (($(count_requests '^PUT .* 500 ') != 2)); then
  set_error "expected 2 uploads answered with 500"
fi
restore_from "${third_jobid}" dplcompat

# 5. A damaged upload (BadDigest) is sent again.
echo 1 >"${control_dir}/put-badmd5"
backup_to dplcompat
fourth_jobid=${backup_jobid}
if (($(count_requests '^PUT .* 400 ') != 1)); then
  set_error "expected 1 upload answered with 400 BadDigest"
fi
restore_from "${fourth_jobid}" dplcompat

# 6. Opening an existing volume lists it page by page.
if (($(count_requests 'continuation-token') < 1)); then
  set_error "no listing used a continuation token"
fi

# 6b. With iothreads=0 a cancel ends an upload the server accepted and then
# left silent (the first chunk is uploaded on the job's own thread).
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $tmp/label-sync.log
label volume=SyncVolume001 storage=dplcompat-sync pool=Full
quit
END_OF_DATA
run_bconsole
rm -f "${control_dir}/put-stalled"
echo 300 >"${control_dir}/put-stall"
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $tmp/cancel-run.log
run job=$JobName level=Full storage=dplcompat-sync yes
quit
END_OF_DATA
run_bconsole
cancel_jobid=$(queued_jobid "$tmp/cancel-run.log")
# The cancel must meet an upload of the volume that is in flight.
waited=0
while [ ! -s "${control_dir}/put-stalled" ]; do
  sleep 0.5
  waited=$((waited + 1))
  if ((waited > 60)); then
    set_error "the upload of SyncVolume001 never started"
    break
  fi
done
if ! grep -q SyncVolume001 "${control_dir}/put-stalled" 2>/dev/null; then
  set_error "the stalled upload is not of SyncVolume001"
fi
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $tmp/cancel.log
cancel jobid=${cancel_jobid} yes
quit
END_OF_DATA
cancel_start=${SECONDS}
run_bconsole
# The SD job (not only the Director's) must end soon: the Director ends a
# canceled job by itself, while the SD thread waits for the silent upload.
sd_idle=""
while ((SECONDS - cancel_start <= 30)); do
  sd_status=$(console_output "status storage=dplcompat-sync")
  if grep -q "No Jobs running" <<<"${sd_status}"; then
    sd_idle=yes
    break
  fi
  sleep 1
done
rm -f "${control_dir}/put-stall"
if [ -z "${sd_idle}" ]; then
  set_error "the SD job was still running 30 s after the cancel"
fi
# The chunk of the canceled upload stays kept.
if ! grep -q "Kept chunks waiting for upload" <<<"${sd_status}" \
  || ! grep -q "/SyncVolume001/0000" <<<"${sd_status}"; then
  set_error "the canceled chunk is not listed as kept"
fi
console_output "wait jobid=${cancel_jobid}" >/dev/null
expect_termination "${cancel_jobid}" "Canceled"

# 7. A chunk missing below the catalog size of the volume ends a restore with
# an error; it is not the end of the volume.
missing_chunk="${archivedir}/TestVolume001.0001"
if [ ! -f "${missing_chunk}" ]; then
  set_error "chunk 1 of TestVolume001 does not exist"
fi
mv "${missing_chunk}" "${tmp}/TestVolume001.0001.saved"
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $tmp/restore-missing.log
restore jobid=${first_jobid} client=bareos-fd storage=dplcompat where=${RestoreDirectory}/missing all done yes
wait
messages
quit
END_OF_DATA
run_bconsole
missing_jobid=$(queued_jobid "$tmp/restore-missing.log")
missing_joblog=$(console_output "list joblog jobid=${missing_jobid}")
if grep -q "Termination:.*Restore OK" <<<"${missing_joblog}"; then
  set_error "a restore with a missing chunk ended OK"
fi
if ! grep -q "is short: chunk 1 is missing" <<<"${missing_joblog}"; then
  set_error "the job log does not say that chunk 1 is missing"
fi
mv "${tmp}/TestVolume001.0001.saved" "${missing_chunk}"

# 8. Neither key appears in the SD trace, the daemon logs or the job logs.
trace_files=$(find "${working}" -name '*.trace' -type f)
if [ -z "${trace_files}" ] \
  || ! grep -qE '(PUT|GET|HEAD) .* -> status' ${trace_files}; then
  set_error "the SD trace holds no request lines"
fi
for secret in "${access_key}" "${secret_key}"; do
  # shellcheck disable=SC2086
  if grep -rlF "${secret}" ${trace_files} "${working}" "${logdir}" \
    "$tmp"/*.log 2>/dev/null | grep -q .; then
    set_error "a key of the s3cfg appears in a trace or a log"
  fi
done

stop_stub
end_test
