# Upload outage longer than flush_timeout (120 s): the job fails with
# "Failed to flush device" within flush_timeout + 60 s, the chunk stays
# queued and is uploaded when the outage ends, and the next job on the same
# device runs and restores byte-identical.

set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

#shellcheck source=fault-functions
. ./fault-functions

start_test
setup_data
faults_clear

log="$tmp/long-outage.out"
rm -f "$log"
rm -rf "$RestoreDirectory"

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out ${NULL_DEV}
messages
@$out $log
label volume=LongOutage-0001 storage=dplcompat pool=LongOutage
quit
END_OF_DATA
run_bconsole

fault_fail_uploads
start=${SECONDS}
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $log
run job=backup-long-outage yes
wait
messages
quit
END_OF_DATA
run_bconsole
elapsed=$((SECONDS - start))
failed_jobid=$(queued_jobid "$log")

expect_grep "Failed to flush device" "$log" \
  "the job did not fail on the flush"
expect_grep "made no progress for 120 seconds" "$log" \
  "the job log does not give the reason of the failed flush"
expect_termination "${failed_jobid}" "Backup Error"
if ((elapsed > 180)); then
  set_error "job ${failed_jobid} took ${elapsed} s, more than flush_timeout + 60 s"
fi

# The outage ends: the queued chunk is uploaded, the device takes a new job.
uploads_before=$(upload_log_lines)
faults_clear
wait_uploaded dplcompat LongOutage-0001 0000 "${uploads_before}" 60

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $log
run job=backup-long-outage yes
wait
messages
quit
END_OF_DATA
run_bconsole
good_jobid=$(queued_jobid "$log")

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $log
restore jobid=${good_jobid} client=bareos-fd where=$RestoreDirectory all done yes
wait
messages
quit
END_OF_DATA
run_bconsole

expect_termination "${good_jobid}" "Backup OK"
expect_grep "Termination:.*Restore OK" "$log" "the restore did not end OK"
check_restore_diff "${BackupDirectory}"

end_test
