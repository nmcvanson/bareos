# Helpers of the dplcompat-faults testrunners; sourced after "functions".
# The fault switches are files read by etc/bareos/fault-wrapper.sh.

fault_dir="${tmp}/faults"
bigdata_dir="${tmp}/bigdata"

faults_clear()
{
  mkdir -p "${fault_dir}"
  rm -f "${fault_dir}/fail-uploads" "${fault_dir}/fail-uploads-until" \
    "${fault_dir}/list-empty-after-ok" "${fault_dir}/fail-uploads-once" \
    "${fault_dir}/fail-list-once" "${fault_dir}/slow-uploads"
}

# Every upload waits the given number of seconds.
fault_slow_uploads()
{
  mkdir -p "${fault_dir}"
  echo "$1" >"${fault_dir}/slow-uploads"
}

fault_fail_uploads()
{
  mkdir -p "${fault_dir}"
  touch "${fault_dir}/fail-uploads"
}

# Only the next upload fails.
fault_fail_upload_once()
{
  mkdir -p "${fault_dir}"
  touch "${fault_dir}/fail-uploads-once"
}

# Only the next "list" fails.
fault_fail_list_once()
{
  mkdir -p "${fault_dir}"
  touch "${fault_dir}/fail-list-once"
}

# Uploads fail for the given number of seconds from now.
fault_fail_uploads_for()
{
  mkdir -p "${fault_dir}"
  echo $(($(date +%s) + $1)) >"${fault_dir}/fail-uploads-until"
}

# "list" of a volume prints nothing once it had the given number of uploads.
fault_list_empty_after()
{
  mkdir -p "${fault_dir}"
  echo "$1" >"${fault_dir}/list-empty-after-ok"
}

# Four 10 MB chunks of incompressible data for the BigData fileset.
setup_bigdata()
{
  mkdir -p "${bigdata_dir}"
  if [ ! -f "${bigdata_dir}/random.bin" ]; then
    dd if=/dev/urandom of="${bigdata_dir}/random.bin" bs=1M count=40 2>/dev/null
  fi
}

# 160 MB of incompressible data for the QueueData fileset.
setup_queuedata()
{
  mkdir -p "${tmp}/queuedata"
  if [ ! -f "${tmp}/queuedata/random.bin" ]; then
    dd if=/dev/urandom of="${tmp}/queuedata/random.bin" bs=1M count=160 2>/dev/null
  fi
}

# Resident memory in kB of the storage daemon of this test.
sd_rss_kb()
{
  "${AWK}" '/^VmRSS:/ {print $2}' "/proc/$(pidof "$(basename "${BAREOS_STORAGEDAEMON_BINARY}")")/status"
}

# 2 MB of incompressible data for the SmallData fileset.
setup_smalldata()
{
  mkdir -p "${tmp}/smalldata"
  if [ ! -f "${tmp}/smalldata/random.bin" ]; then
    dd if=/dev/urandom of="${tmp}/smalldata/random.bin" bs=1M count=2 2>/dev/null
  fi
}

# Bytes the store holds for a volume: the sum of its chunk files.
bucket_bytes()
{
  local total=0 f
  for f in "${archivedir}/$1".*; do
    [ -f "$f" ] && total=$((total + $(wc -c <"$f")))
  done
  echo "${total}"
}

# Volume names the catalog lists for a job.
job_volumes()
{
  console_output "list jobmedia jobid=$1" \
    | "${AWK}" -F'|' '$2 ~ /^ *[0-9]+ *$/ {gsub(" ","",$3); print $3}' \
    | sort -u
}

# Records an error when the store holds fewer bytes of a volume than the
# catalog says were written to it, or more than $2 bytes beyond that (a kept
# chunk may hold the first part of the block whose write was refused).
expect_volume_stored()
{
  local volume="$1" max_excess="${2:-}" stored catalog
  stored=$(bucket_bytes "${volume}")
  catalog=$(volume_bytes "${volume}")
  echo "volume ${volume}: store ${stored} bytes, catalog ${catalog}" \
    >>"${tmp}/volume-sizes.log"
  if [ -z "${catalog}" ] || ((stored < catalog)); then
    set_error "volume ${volume}: store holds ${stored} bytes, catalog ${catalog}"
  elif [ -n "${max_excess}" ] && ((stored - catalog >= max_excess)); then
    set_error "volume ${volume}: store holds ${stored} bytes, more than a block beyond the catalog's ${catalog}"
  fi
}

# Maximum Block Size of the dplcompat devices (the default, 1 MiB).
max_block_size=1048576

# Output of one bconsole command.
console_output()
{
  "${BAREOS_BCONSOLE_BINARY}" -c "${BAREOS_CONFIG_DIR}" <<<"$1"
}

# Bytes the catalog holds for a volume.
volume_bytes()
{
  local output
  output=$(console_output ".api 2
.sql query=\"SELECT volbytes FROM media WHERE volumename='$1';\"")
  "${AWK}" '/"volbytes":/ {gsub("[\",\\r]","",$2); print $2}' <<<"${output}"
}

# Status the catalog holds for a volume.
volume_status()
{
  local output
  output=$(console_output ".api 2
.sql query=\"SELECT volstatus FROM media WHERE volumename='$1';\"")
  "${AWK}" '/"volstatus":/ {gsub("[\",\\r]","",$2); print $2}' <<<"${output}"
}

# Number of lines in the wrapper's upload log.
upload_log_lines()
{
  if [ -f "${fault_dir}/upload.log" ]; then
    wc -l <"${fault_dir}/upload.log"
  else
    echo 0
  fi
}

# Waits until volume/chunk was uploaded after line $4 of the upload log and
# storage $1 no longer lists it as pending; fails after $5 seconds.
wait_uploaded()
{
  local storage="$1"
  local volume="$2"
  local chunk="$3"
  local after_line="$4"
  local timeout="$5"
  local start=${SECONDS}
  local uploads status
  while ((SECONDS - start < timeout)); do
    uploads=$(tail -n +"$((after_line + 1))" "${fault_dir}/upload.log" || :)
    status=$(console_output "status storage=${storage}")
    if grep -q "^${volume}.${chunk} ok " <<<"${uploads}" \
      && ! grep -q "/${volume}/${chunk}" <<<"${status}"; then
      return 0
    fi
    sleep 1
  done
  set_error "${volume}/${chunk} was not uploaded within ${timeout} s"
  return 1
}

# Records an error unless the job log shows the expected termination.
expect_termination()
{
  local jobid="$1"
  local expected="$2"
  local joblog
  joblog=$(console_output "list joblog jobid=${jobid}")
  if ! grep -q "Termination:.*${expected}" <<<"${joblog}"; then
    set_error "job ${jobid} did not end with \"${expected}\""
  fi
}

# Prints the JobId of the last "run" in a log file.
queued_jobid()
{
  grep 'Job queued. JobId=' "$1" | tail -n 1 | sed -n -e 's/^.*JobId=//p'
}
