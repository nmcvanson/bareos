# A device with retries=2 whose uploads fail: the job fails with a message
# naming the chunk, the chunk is kept in the upload queue instead of being
# dropped, it is uploaded when the store works again, and the device then
# takes the next job, which restores byte-identical.

set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

#shellcheck source=fault-functions
. ./fault-functions

start_test
setup_data
faults_clear

log="$tmp/retries.out"
status_log="$tmp/retries-status.out"
rm -f "$log" "$status_log"
rm -rf "$RestoreDirectory"

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out ${NULL_DEV}
messages
@$out $log
label volume=Retry-0001 storage=dplcompat-retry pool=Retry
quit
END_OF_DATA
run_bconsole

fault_fail_uploads
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $log
run job=backup-retry yes
wait
messages
quit
END_OF_DATA
run_bconsole
failed_jobid=$(queued_jobid "$log")

expect_termination "${failed_jobid}" "Backup Error"
expect_grep "chunk 0 of volume Retry-0001 could not be uploaded after 2 tries" \
  "$log" "the job log does not name the chunk that could not be uploaded"
expect_grep "Failed to flush device" "$log" \
  "the job did not fail on the flush"

# The chunk is listed as pending except while one of its retries runs.
for _ in 1 2 3 4 5; do
  console_output "status storage=dplcompat-retry" >"$status_log"
  grep -q "/Retry-0001/0000" "$status_log" && break
  sleep 1
done
expect_grep "/Retry-0001/0000" "$status_log" \
  "the chunk was dropped from the upload queue"

# The store works again: the kept chunk is uploaded and the device takes
# writes again.
uploads_before=$(upload_log_lines)
faults_clear
wait_uploaded dplcompat-retry Retry-0001 0000 "${uploads_before}" 60

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $log
run job=backup-retry yes
wait
messages
quit
END_OF_DATA
run_bconsole
good_jobid=$(queued_jobid "$log")
expect_termination "${good_jobid}" "Backup OK"

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $log
restore jobid=${good_jobid} client=bareos-fd where=$RestoreDirectory all done yes
wait
messages
quit
END_OF_DATA
run_bconsole

expect_grep "Termination:.*Restore OK" "$log" "the restore did not end OK"
check_restore_diff "${BackupDirectory}"

end_test
