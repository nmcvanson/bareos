# Blocking uploads (iothreads=0): one upload fails while a job appends to a
# volume that already holds a good job. The job fails at once with a fatal
# message naming the chunk, without moving on to a new volume, and the
# earlier job still restores byte-identical. The failed chunk is kept and
# uploaded when the next job opens the device.

set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

#shellcheck source=fault-functions
. ./fault-functions

start_test
setup_bigdata
faults_clear

log="$tmp/sync-upload.out"
rm -f "$log"
rm -rf "$RestoreDirectory"

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out ${NULL_DEV}
messages
@$out $log
label volume=Sync-0001 storage=dplcompat-sync pool=Sync
run job=backup-sync yes
wait
messages
quit
END_OF_DATA
run_bconsole
good_jobid=$(queued_jobid "$log")
expect_termination "${good_jobid}" "Backup OK"

fault_fail_upload_once
start=${SECONDS}
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $log
run job=backup-sync yes
wait
messages
quit
END_OF_DATA
run_bconsole
elapsed=$((SECONDS - start))
failed_jobid=$(queued_jobid "$log")
faults_clear

expect_termination "${failed_jobid}" "Backup Error"
expect_grep "could not upload chunk [0-9]* of volume Sync-0001" "$log" \
  "the job log does not name the chunk that could not be uploaded"
expect_not_grep "End of medium" "$log" \
  "the failed upload was taken for the end of the volume"
if ((elapsed > 60)); then
  set_error "job ${failed_jobid} took ${elapsed} s to fail"
fi
# Nothing is appended after the refused block's first part in the kept chunk.
if [ "$(volume_status Sync-0001)" != "Full" ]; then
  set_error "Sync-0001 is not Full after the refused write"
fi
volumes=$(console_output "list volumes pool=Sync")
if grep -q "Sync-0002" <<<"${volumes}"; then
  set_error "a second volume was labeled after the failed upload"
fi

# The failed chunk was kept: the next job's open uploads it, so the volume is
# fully stored, and that job ends OK.
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $log
run job=backup-sync yes
wait
messages
quit
END_OF_DATA
run_bconsole
next_jobid=$(queued_jobid "$log")
expect_termination "${next_jobid}" "Backup OK"
expect_volume_stored Sync-0001 "${max_block_size}"

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $log
restore jobid=${good_jobid} client=bareos-fd where=$RestoreDirectory all done yes
wait
messages
quit
END_OF_DATA
run_bconsole

expect_grep "Termination:.*Restore OK" "$log" "the restore did not end OK"
check_restore_diff "${bigdata_dir}"

end_test
