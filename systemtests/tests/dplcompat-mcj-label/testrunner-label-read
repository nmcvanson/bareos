# Blocking uploads (iothreads=0) with two concurrent jobs on one device. The
# second job starts when the first one has already passed the first chunk, so
# the first job holds unflushed bytes of a later chunk when the second job's
# mount closes the device and reads the volume label. Both jobs must end OK
# and restore byte-identical.

set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

#shellcheck source=fault-functions
. ./fault-functions

start_test
setup_mcjdata 120
setup_smalldata
faults_clear

log="$tmp/label-read.out"
rm -f "$log"
rm -rf "$RestoreDirectory"

join_scenario dplcompat-mcj McjLabel McjLabel-0001

end_test
