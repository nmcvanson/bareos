# Two concurrent jobs on one device with upload threads (iothreads=2,
# ioslots=1, so the first job waits for the slow uploads). The second job
# starts when the first one has stored its second chunk. Both jobs must end
# OK and restore byte-identical.

set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

#shellcheck source=fault-functions
. ./fault-functions

start_test
setup_mcjdata 120
setup_smalldata
faults_clear

log="$tmp/label-read-io.out"
rm -f "$log"
rm -rf "$RestoreDirectory"

join_scenario dplcompat-mcj-io McjIo McjIo-0001

end_test
