set -euo pipefail
. ./openstack-test-common
openstack_test_begin
fake_cli init --reset --spec "$current_test_directory/fakecloud-spec.json"
fake_cli fault --op create_volume --phase after
log="$tmp/openstack-fault.out"
cat >"$tmp/bconcmds" <<END_OF_DATA
@$out $log
run job=backup-openstack level=Full yes
wait
messages
END_OF_DATA
run_bconsole "$@"
grep -Eiq 'chunk producer failed|backup preparation failed|Error|Fatal' "$log"
fake_cli check-clean
fake_cli clear-faults
end_test
