# Transfer mode (proxy_mode=transfer) against a two-project fake cloud: the
# tenant owns the server, the provider project owns the proxy.
set -euo pipefail
. ./openstack-test-common
openstack_test_begin
fake_cli init --reset --spec "$current_test_directory/fakecloud-spec-transfer.json"
provider_project=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
provider_file="$BAREOS_CONFIG_DIR/bareos-fd.d/provider.ini"
mkdir -p "$BAREOS_CONFIG_DIR/bareos-fd.d"
(umask 077 && printf 'backend=fake\nfake_project_id=%s\nproxy_instance_id=22222222-2222-4222-8222-222222222222\n' "$provider_project" >"$provider_file")
ln -sf "$provider_file" "$BAREOS_CONFIG_DIR/provider.ini"

backup_log="$tmp/openstack-transfer-backup.out"
restore_log="$tmp/openstack-transfer-restore.out"
cat >"$tmp/bconcmds" <<END_OF_DATA
messages
@$out $backup_log
label volume=OpenStackTransfer storage=File pool=Full
run job=backup-openstack fileset=OpenStackTransfer level=Full yes
wait
messages
END_OF_DATA
run_bconsole "$@"
check_log "$backup_log"
fake_cli check-clean

cat >"$tmp/bconcmds" <<END_OF_DATA
@$out $restore_log
restore client=bareos-fd fileset=OpenStackTransfer select all done pluginoptions=${plugin_name}:restore_name=web01-xfer
yes
wait
END_OF_DATA
run_bconsole "$@"
check_log "$restore_log"
listing=$(fake_cli servers --name web01-xfer)
[ "$(printf '%s' "$listing" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))')" -eq 1 ]
restored_ids=$(printf '%s' "$listing" | python3 -c 'import json,sys; print(" ".join(json.load(sys.stdin)[0]["volume_ids"]))')
root_id=$(printf '%s\n' "$restored_ids" | awk '{print $1}')
data_id=$(printf '%s\n' "$restored_ids" | awk '{print $2}')
server_project=$(printf '%s' "$listing" | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["project_id"])')
[ "$server_project" = 11111111-1111-4111-8111-111111111111 ]
cmp -n 8388608 "$(fake_cli volume-path --volume "$root_id")" \
  "$(fake_cli volume-path --volume 44444444-4444-4444-8444-444444444444)"
cmp -n 4194304 "$(fake_cli volume-path --volume "$data_id")" \
  "$(fake_cli volume-path --volume 66666666-6666-4666-8666-666666666666)"
fake_cli check-clean

# the operator tool sees nothing left in either project
python3 -m bareos_openstack.tool --backend fake --fake-root "$OPENSTACK_FAKE_ROOT" \
  --proxy-credentials "$provider_file" leftovers | grep -Fxq 'no leftovers'
rm -f "$provider_file" "$BAREOS_CONFIG_DIR/provider.ini"
end_test
