FileSet {
  Name = "OpenStackTransfer"
  Description = "Test the Bareos OpenStack plugin in transfer mode against the fake cloud."
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "@dir_python_module_name@:module_path=@python_plugin_module_src_test_dir@:module_name=bareos-fd-openstack:backend=fake:proxy_mode=transfer:proxy_project_credentials=provider.ini:fake_root=@tmp@/openstack-fake-root:server_id=33333333-3333-4333-8333-333333333333:chunk_size=1MiB"
  }
}
