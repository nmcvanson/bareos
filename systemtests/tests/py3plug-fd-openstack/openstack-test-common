openstack_test_begin()
{
  TestName="$(basename "$(pwd)")"
  export TestName
  JobName=backup-openstack
  . ./environment
  export PATH="$current_test_directory/sbin:$current_test_directory/bin:$PATH"
  . "$BAREOS_SCRIPTS_DIR"/functions
  # plugin name in plugin options: the bridge variant names the inferior
  # explicitly, the automatic gRPC variant keeps python3
  case "$(basename "$current_test_directory")" in
    py3grpc-*) plugin_name=grpc:bareos-grpc-fd-plugin-bridge:python3 ;;
    *) plugin_name=python3 ;;
  esac
  export plugin_name
  export OPENSTACK_FAKE_ROOT="$tmp/openstack-fake-root"
  export PYTHONPATH="$current_test_directory/python-modules${PYTHONPATH:+:$PYTHONPATH}"
  start_test
}

fake_cli()
{
  python3 -m bareos_openstack.fake_backend "$@" --root "$OPENSTACK_FAKE_ROOT"
}
