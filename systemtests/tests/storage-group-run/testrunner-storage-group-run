set -e
set -o pipefail
set -u
#
# A Job may declare several Storage resources ("Storage = File, File2"). The
# Director keeps them in write_storage_list and hands the whole list to the
# Storage Daemon, which picks a device.
#
# The console "run" command used to destroy that list: with no explicit
# "storage=" it filled a default from GetJobStorage and then called
# SetRwstorage unconditionally, which frees the list and rebuilds it with one
# member. The scheduler never did this -- it overrides only when the Run
# resource carries its own Storage directive.
#
# These three cases pin down the corrected behaviour.
#
TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

start_test

grouplog="$tmp/group-default.out"
explicitlog="$tmp/group-explicit.out"
singlelog="$tmp/single-storage.out"

rm -f "$grouplog" "$explicitlog" "$singlelog"

# Case 1: a Job-declared group, started with no "storage=".
# The list must survive to DoNativeBackupInit with both members present.
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out ${NULL_DEV}
messages
@$out $grouplog
run job=backup-group level=Full yes
wait
messages
END_OF_DATA

run_bconsole

expect_grep "Storage group: 2 candidates" \
  "$grouplog" \
  "The storage group was collapsed before reaching DoNativeBackupInit."

expect_grep "Termination: *Backup OK" \
  "$grouplog" \
  "Backup through a storage group did not terminate correctly."

# Case 2: the same Job, but the user names a storage explicitly.
# An explicit storage= is still an override and must collapse the group.
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out ${NULL_DEV}
messages
@$out $explicitlog
run job=backup-group storage=File2 level=Full yes
wait
messages
END_OF_DATA

run_bconsole

expect_not_grep "Storage group:" \
  "$explicitlog" \
  "An explicit storage= must override the whole group, not just reorder it."

expect_grep "Using Device \"FileStorage2\" to write." \
  "$explicitlog" \
  "Explicit storage=File2 did not reach FileStorage2."

expect_grep "Termination: *Backup OK" \
  "$explicitlog" \
  "Backup with an explicit storage did not terminate correctly."

# Case 3: a Job with a single Storage is not a group, and must behave exactly
# as it did before this change.
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out ${NULL_DEV}
messages
@$out $singlelog
run job=backup-bareos-fd level=Full yes
wait
messages
END_OF_DATA

run_bconsole

expect_not_grep "Storage group:" \
  "$singlelog" \
  "A Job with one Storage must not report a storage group."

expect_grep "Termination: *Backup OK" \
  "$singlelog" \
  "Single-storage backup did not terminate correctly."

check_for_zombie_jobs storage=File

end_test
